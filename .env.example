# Application Environment Configuration
# Copy this file to .env and .env.development, .env.production, etc. and fill in actual values

# Server Configuration
NODE_ENV=development
PORT=3001

# Database Configuration
# For SQLite (development):
DATABASE_PATH=./database.sqlite
# For Neon PostgreSQL (production):
# DATABASE_URL=postgresql://user:password@host/database
# NEON_CONNECTION_STRING=postgresql://user:password@host/database

# Security
JWT_SECRET=your-jwt-secret-key-here-min-32-chars
DEFAULT_PIN=5624

# Frontend
FRONTEND_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:3000

# HTTPS Configuration (production only)
USE_HTTPS=false
# SSL_PRIVATE_KEY_PATH=/path/to/private.key
# SSL_CERT_PATH=/path/to/certificate.crt

# Storage Configuration
STORAGE_PROVIDER=local
# For Cloudflare R2:
# STORAGE_PROVIDER=r2
# R2_ACCOUNT_ID=your-account-id
# R2_ACCESS_KEY_ID=your-access-key-id
# R2_SECRET_ACCESS_KEY=your-secret-access-key
# R2_BUCKET_NAME=your-bucket-name

# File Upload Limits
MAX_UPLOAD_SIZE_BYTES=10485760
DIRECT_UPLOAD_THRESHOLD_BYTES=2097152
CSV_TRANSACTION_MAX_WAIT_MS=10000
CSV_TRANSACTION_TIMEOUT_MS=60000

# Error Handling
ERROR_HIDE_STACK_TRACE_IN_PRODUCTION=true
ERROR_LOG_LEVEL=error

# Observability (Optional)
SENTRY_DSN=
SENTRY_FRONTEND_DSN=

# Stripe Configuration (for SaaS monetization)
# Get these from https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_xxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxx

# Organization Invite Mode
# Clerk-managed invites are the default and recommended mode.
ENABLE_CUSTOM_ORG_INVITES=false

# CORS Configuration
CORS_ORIGINS=http://localhost:3000
