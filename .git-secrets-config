## Setup Instructions
#
# 1. Install git-secrets:
#    brew install git-secrets        # macOS
#    sudo apt install git-secrets    # Ubuntu/Debian
#
# 2. Initialize in repository:
#    git secrets --install
#    git secrets --register-aws
#
# 3. Add custom patterns:
#    git secrets --add 'pattern-here'
#
# 4. Add exceptions:
#    git secrets --add --allowed 'exception-here'
#
# 5. Scan repository:
#    git secrets --scan               # Scan staged files
#    git secrets --scan-history       # Scan entire history
#
# 6. Install pre-commit hook:
#    cp scripts/pre-commit-secrets.sh .git/hooks/pre-commit
#    chmod +x .git/hooks/pre-commit
