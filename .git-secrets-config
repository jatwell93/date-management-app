# git-secrets configuration for Date Management App
# Task 6.2: Project-specific patterns for secrets scanning
#
# This file documents the patterns configured for git-secrets.
# To apply these patterns, run the setup script or manually execute:
#
#   git secrets --install
#   git secrets --register-aws
#   git secrets --add '<pattern>'
#   git secrets --add --allowed '<exception>'

## Standard AWS Patterns
# Registered via: git secrets --register-aws
# - AWS Access Key ID (AKIA...)
# - AWS Secret Access Key
# - AWS Session Tokens

## Custom API Keys & Tokens
# Pattern: password=, api_key=, secret_key=, token=
password\s*[:=]\s*["']?.{8,}["']?
api[_-]?key\s*[:=]\s*["']?.{16,}["']?
secret[_-]?key\s*[:=]\s*["']?.{16,}["']?
token\s*[:=]\s*["']?.{16,}["']?
jwt[_-]?secret\s*[:=]\s*["']?.{16,}["']?

## Database Connection Strings with Credentials
# Pattern: postgresql://user:password@host
database[_-]?url\s*[:=]\s*["']?.*\:\/\/.*\:.*\@

## Service-Specific API Keys
AKIA[0-9A-Z]{16}                # AWS Access Key ID
sk-[a-zA-Z0-9]{32,}             # OpenAI API Key
ghp_[a-zA-Z0-9]{36,}            # GitHub Personal Access Token
gho_[a-zA-Z0-9]{36,}            # GitHub OAuth Token
github_pat_[a-zA-Z0-9_]{82}     # GitHub Fine-grained PAT
xoxb-[0-9]{10,13}-[0-9]{10,13}-[a-zA-Z0-9]{24}  # Slack Bot Token
xoxp-[0-9]{10,13}-[0-9]{10,13}-[a-zA-Z0-9]{24}  # Slack User Token

## Private Keys
'-----BEGIN\s+(RSA|DSA|EC|OPENSSH)\s+PRIVATE\s+KEY-----

## Cloudflare R2 Access Keys
# Pattern: Cloudflare access key IDs (32 hex chars)
r2[_-]?access[_-]?key[_-]?id\s*[:=]\s*["']?[a-f0-9]{32}["']?
r2[_-]?secret[_-]?access[_-]?key\s*[:=]\s*["']?.{40,}["']?

## Neon Database API Keys
# Pattern: Neon API keys typically follow neon_ prefix
neon[_-]?api[_-]?key\s*[:=]\s*["']?[a-zA-Z0-9_-]{32,}["']?

## JWT Secrets
# Pattern: JWT_SECRET= followed by random string
JWT_SECRET\s*=\s*["']?.{32,}["']?

## Allowed Exceptions (won't trigger alerts)
