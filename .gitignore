.codex/
# Devin CLI: ignore machine-local state, but TRACK the safety guard. A guard that
# exists on one machine is not a guard — the wrapper fails open when absent.
.devin/*
!.devin/hooks/
!.devin/hooks.v1.json
!.devin/dcg-devin.toml
/specs/
prompts/
skills/
# ...but first-party Claude Code skills are repo tooling and belong in version control.
# (.claude/ itself is already tracked — settings.json, hooks/.) Git will not descend into
# an excluded directory, so .claude/skills/ must be re-included before a child negation
# can take effect. Installed/third-party skills stay ignored; add one negation per skill
# we author ourselves.
!.claude/skills/
.claude/skills/*
!.claude/skills/delegate/
instructions/
agents/
go-to-market-docs/
brand-identity-pharma-apps/
brand-identity/

# Real pharmacy data with sensitive information
supplier-doc-examples/*
!supplier-doc-examples/sample_100_ipa_price_brands.xlsx

# Coverage
coverage/
bug-scan-report.json
bug-scan-report.txt
.env
.env.local
tech-debt.md

#cloudflare workers
workers/.wrangler/

# Local worker dev secrets — commit only the .example template
workers/.dev.vars
workers/.dev.vars.*
!workers/.dev.vars.example

# Generated copy of wrangler.toml written by vitest.config.mts so the workerd
# test pool's config lives in a directory with no neighbouring .dev.vars
workers/.vitest-tmp/

# Playwright
e2e/.auth/
test-results/
playwright-report/
.playwright-mcp/
.expect/
.serena/memories/
# graphify (tool removed; ignore any regenerated output)
graphify-out/

# quint (tool removed; leftover local db, not for commit)
.quint/

# agentlens (tool retired from the workflow, but the CLI may still be
# installed locally and regenerate this; never commit generated docs)
.agentlens/

# scripts/pitr-drill.sh writes its run log to the repo root. Reviewed, redacted
# copies belong in docs/evidence/<date>-<task>/ — the raw run log must never be
# committed by accident.
pitr-drill-evidence-*.txt

# Local agent scratch output (never committed)
.tmp-agent-scratch/
