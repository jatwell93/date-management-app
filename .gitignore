e2e/.auth/
test-results/
playwright-report/
.playwright-mcp/
.expect/
.serena/memories/
# graphify (tool removed; ignore any regenerated output)
graphify-out/

# quint (tool removed; leftover local db, not for commit)
.quint/

# agentlens (tool retired from the workflow, but the CLI may still be
# installed locally and regenerate this; never commit generated docs)
.agentlens/

# scripts/pitr-drill.sh writes its run log to the repo root. Reviewed, redacted
# copies belong in docs/evidence/<date>-<task>/ — the raw run log must never be
# committed by accident.
pitr-drill-evidence-*.txt
