# Files and folders UBS should ignore (reduce scanner noise)
# Exclude generated/build/coverage artifacts and environment example files

# build / dist / compiled outputs
dist/
build/
frontend/build/
workers/.wrangler/

# coverage reports and HTML output
coverage/
**/coverage/
**/lcov-report/
**/lcov.info

# TypeScript / JS compiled artifacts
**/*.map
**/*.min.js

# Environment files and examples (treat .env entries as false-positives)
.env
.env.*
.env.example

# Database files
*.sqlite*

# Node modules / caches
node_modules/
.cache/

# Other noisy/generated artifacts
frontend/build/
bug-scan-report.json
**/*.test.*  
**/*.spec.*  
**/test/**  
**/tests/**  
**/__tests__/**

# Ignore IDE / OS files
.vscode/
.DS_Store

# Windsurf IDE scripts (third-party, not project code)
.windsurf/
