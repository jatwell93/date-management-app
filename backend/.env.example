# Environment Configuration
NODE_ENV=development  # development | production | test | staging

# Database Configuration
# Prisma database provider
DATABASE_PROVIDER=sqlite  # sqlite (development) | postgresql (production)

# Development Database (SQLite)
DATABASE_PATH=./database.sqlite
DATABASE_URL=file:./database.sqlite

# Production Database (Neon PostgreSQL)
# Uncomment for production use
# DATABASE_PROVIDER=postgresql
# DATABASE_URL=postgresql://user:password@host/database?sslmode=require
# NEON_CONNECTION_STRING=postgresql://user:password@host/database?sslmode=require

# Legacy: PlanetScale (MySQL) - deprecated in favor of Neon
# DATABASE_PROVIDER=mysql
# DATABASE_URL=mysql://user:password@host/database?sslaccept=strict

# Storage Configuration
STORAGE_PROVIDER=local  # local | r2

# Development Storage (Local Filesystem)
UPLOAD_DIR=./uploads

# Production Storage (Cloudflare R2)
# Uncomment for production use
# R2_ACCOUNT_ID=your_account_id
# R2_ACCESS_KEY_ID=your_access_key_id
# R2_SECRET_ACCESS_KEY=your_secret_access_key
# R2_BUCKET_NAME=csv-uploads-prod

# API Configuration
PORT=3001
FRONTEND_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:3000

# JWT Configuration
JWT_SECRET=your-secret-key-here-change-in-production
JWT_EXPIRES_IN=7d

# File Upload Limits
MAX_FILE_SIZE=10485760  # 10MB in bytes
MAX_UPLOAD_SIZE_BYTES=10485760  # Preferred, mirrors MAX_FILE_SIZE
DIRECT_UPLOAD_THRESHOLD_BYTES=2097152  # 2MB in bytes
CSV_BATCH_SIZE=100  # Rows per batch for CSV processing

# Rate Limiting
RATE_LIMIT_WINDOW=60000  # 1 minute in ms
RATE_LIMIT_MAX_REQUESTS=10  # For unauthenticated users
RATE_LIMIT_MAX_AUTHENTICATED=100  # For authenticated users

# Security Configuration
# CORS origins (comma-separated list for multiple domains)
CORS_ORIGINS=http://localhost:3000,http://localhost:3001  # development
# CORS_ORIGINS=https://app.example.com  # production

# Request size limits
MAX_REQUEST_SIZE=10485760  # 10MB in bytes

# TLS/SSL Configuration
# Ensure DATABASE_URL includes sslmode=require for production
# Example: postgresql://user:password@host/database?sslmode=require

# Secrets Scanning
# Run: npm run secrets-scan before committing
# Run: git secrets --scan to manually check for secrets

# Error Handling
# Error response format: production masks internal details
# Development: full stack traces; Production: sanitized messages

# Monitoring & Observability
SENTRY_DSN=  # Add Sentry DSN for error tracking
SENTRY_ENVIRONMENT=development  # development | staging | production
SENTRY_TRACES_SAMPLE_RATE=0.1  # 10% of transactions

# Stripe Configuration (SaaS Monetization)
STRIPE_SECRET_KEY=  # sk_test_... for test mode, sk_live_... for production
STRIPE_WEBHOOK_SECRET=  # whsec_... from Stripe Dashboard → Webhooks

# SendGrid Configuration (Email Notifications)
SENDGRID_API_KEY=  # SG.... from SendGrid Dashboard → API Keys
SENDGRID_FROM_EMAIL=  # e.g. noreply@yourdomain.com
