{
  "name": "backend",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "setup": "node scripts/setup.js",
    "start": "ts-node src/index.ts",
    "dev": "nodemon --watch src --watch .env --watch .env.development --ext ts,json --exec ts-node src/index.ts",
    "build": "tsc",
    "test": "node scripts/run-tests.js run",
    "test:coverage": "node scripts/run-tests.js run --coverage",
    "test:diff": "node scripts/run-tests.js run --changed origin/main",
    "test:dev": "node scripts/run-tests.js run",
    "test:prod": "vitest run --config vitest.config.neon.ts",
    "test:both": "npm run test:dev && npm run test:prod",
    "test:watch": "node scripts/run-tests.js",
    "test:verbose": "node scripts/run-tests.js run --reporter verbose",
    "migrate": "ts-node src/migrations/migrate.ts",
    "migrate:status": "ts-node -e \"(async () => { const { MigrationService } = await import('./src/migrations/migration.service.ts'); const service = new MigrationService(); const status = await service.getMigrationStatus(); console.log('Migration Status:\\n================='); console.log(`Executed migrations: ${status.executed.length}`); console.log(`Pending migrations: ${status.pending.length}`); if (status.executed.length > 0) { console.log('\\nExecuted migrations:'); status.executed.forEach(m => { console.log(`  - ${m.id}: ${m.name} (${m.executed_at})`); }); } if (status.pending.length > 0) { console.log('\\nPending migrations:'); status.pending.forEach(m => { console.log(`  - ${m.id}: ${m.name}`); }); } })();\"",
    "migrate:rollback": "ts-node -e \"(async () => { const { MigrationService } = await import('./src/migrations/migration.service.ts'); const service = new MigrationService(); await service.rollbackLastMigration(); })();\"",
    "db:migrate": "npm run migrate",
    "db:status": "npm run migrate:status",
    "db:rollback": "npm run migrate:rollback",
    "db:reset": "rm -f database.sqlite && npm run migrate && npm run seed && npm run seed:tier-flags",
    "db:studio": "prisma studio",
    "seed": "node scripts/seed-users.js",
    "seed:tier-flags": "node scripts/seed-tier-feature-flags.js",
    "audit:org-ids": "npx ts-node scripts/audit-org-ids.ts",
    "export:neon-to-sqlite": "npx ts-node scripts/neon-to-sqlite.ts",
    "export:excess-products": "npx ts-node scripts/export-excess-products.ts",
    "diagnose:webhook": "npx ts-node scripts/diagnose-webhook.ts",
    "verify:neon": "node scripts/verify-neon-doppler.js",
    "migrate:prod": "node scripts/migrate-production-doppler.js",
    "secrets-scan": "git secrets --scan || echo 'git-secrets not installed. Install from: https://github.com/awslabs/git-secrets'",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"src/**/*.ts\" \"scripts/**/*.js\"",
    "type-check": "tsc --noEmit",
    "workers:dev": "cd ../workers && wrangler dev",
    "workers:deploy:dev": "cd ../workers && wrangler deploy --env development",
    "workers:deploy:prod": "cd ../workers && wrangler deploy --env production"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1053.0",
    "@aws-sdk/s3-request-presigner": "^3.1053.0",
    "@clerk/backend": "^3.4.13",
    "@prisma/adapter-planetscale": "^7.8.0",
    "@prisma/client": "^5.22.0",
    "@sendgrid/mail": "^8.1.6",
    "@sentry/node": "^10.53.1",
    "@sentry/profiling-node": "^10.53.1",
    "@types/sqlite3": "^3.1.11",
    "bcrypt": "^5.1.1",
    "better-sqlite3": "^12.10.0",
    "cors": "^2.8.6",
    "csv-parse": "^6.2.1",
    "dotenv": "^17.4.2",
    "express": "^4.22.2",
    "express-rate-limit": "^8.5.2",
    "helmet": "^8.2.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.2.0",
    "node-cron": "^4.2.1",
    "pg": "^8.21.0",
    "prisma": "^5.22.0",
    "reflect-metadata": "^0.1.14",
    "sqlite": "^5.1.1",
    "sqlite3": "^6.0.1",
    "stripe": "^13.10.0",
    "svix": "^1.94.0",
    "tsyringe": "^4.8.0",
    "validator": "^13.15.35",
    "xlsx": "^0.18.5",
    "zod": "^4.4.3"
  },
  "overrides": {
    "tar": "7.5.17",
    "ws": "8.21.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260628.1",
    "@swc/core": "^1.15.43",
    "@types/bcrypt": "^5.0.2",
    "@types/better-sqlite3": "^7.6.13",
    "@types/cors": "^2.8.19",
    "@types/csv-parse": "^1.1.12",
    "@types/express": "^4.17.25",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/multer": "^2.1.0",
    "@types/node": "^26.1.1",
    "@types/node-cron": "^3.0.11",
    "@types/pg": "^8.20.0",
    "@types/supertest": "^6.0.3",
    "@types/validator": "^13.15.10",
    "@types/xlsx": "^0.0.36",
    "@typescript-eslint/eslint-plugin": "^8.62.0",
    "@typescript-eslint/parser": "^8.59.4",
    "@vitest/coverage-v8": "^4.1.9",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "nodemon": "^3.1.14",
    "prettier": "^3.9.1",
    "supertest": "^7.2.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^6.0.3",
    "unplugin-swc": "^1.5.9",
    "vitest": "^4.1.9"
  }
}
