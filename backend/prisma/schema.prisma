// Prisma Schema for Date Management App
// Supports SQLite (development) and MySQL/PlanetScale (production)
//
// For production deployment with PlanetScale:
// 1. Copy schema.planetscale.prisma to schema.prisma
// 2. Or use prisma generate --schema=./prisma/schema.planetscale.prisma

generator client {
  provider = "prisma-client-js"
}

// Development: SQLite
// For production, use production/schema.prisma
datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}
// ============================================================================
// Multi-Tenant SaaS Models
// ============================================================================

model Organization {
  id           String   @id @default(uuid())
  name         String
  slug         String   @unique
  contactEmail String?  @map("contact_email") // For subscription/billing notifications
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  // Relations
  subscriptionTiers       SubscriptionTier[]
  organizationUsages      OrganizationUsage[]
  products                Product[]
  inventoryItems          InventoryItem[]
  storeAreas              StoreArea[]
  users                   User[]
  uploads                 Upload[]
  auditLogs               AuditLog[]
  itemTransactions        ItemTransaction[]
  expiredItemTransactions ExpiredItemTransaction[]

  @@map("organizations")
}

model SubscriptionTier {
  id                   Int      @id @default(autoincrement())
  organizationId       String   @map("organization_id")
  tierLevel            String   @map("tier_level") // 'starter' | 'professional' | 'premium' | 'concierge'
  stripeSubscriptionId String?  @map("stripe_subscription_id")
  trialEndDate         DateTime? @map("trial_end_date")
  status               String   @default("active") // 'active' | 'canceled' | 'past_due' | 'trialing'
  billingCycle         String   @default("monthly") @map("billing_cycle") // 'monthly' | 'annual'
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  // Relations
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([tierLevel])
  @@index([status])
  @@map("subscription_tiers")
}

model TierFeatureFlag {
  id         Int     @id @default(autoincrement())
  tierLevel  String  @map("tier_level")
  featureKey String  @map("feature_key")
  enabled    Boolean @default(true)
  limitValue Int?    @map("limit_value") // For limits like max_skus, max_users

  @@unique([tierLevel, featureKey])
  @@index([tierLevel])
  @@map("tier_feature_flags")
}

model OrganizationUsage {
  id                Int     @id @default(autoincrement())
  organizationId    String  @map("organization_id")
  activeUsers       Int     @default(0) @map("active_users")
  maxUsers          Int     @map("max_users")
  totalSkus         Int     @default(0) @map("total_skus")
  maxSkus           Int     @map("max_skus")
  storageUsedBytes  Int     @default(0) @map("storage_used_bytes")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  // Relations
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId])
  @@map("organization_usage")
}

model ProcessedWebhookEvent {
  id          String   @id // Stripe event ID
  eventType   String   @map("event_type")
  processedAt DateTime @default(now()) @map("processed_at")

  @@index([eventType, processedAt])
  @@map("processed_webhook_events")
}

// ============================================================================
// Existing Models (updated for multi-tenancy)
// ============================================================================

model Product {
  id             Int      @id @default(autoincrement())
  organizationId String?  @map("organization_id")
  barcode        String
  sku            String
  name           String
  costPrice      Float    @map("cost_price")
  notes          String   @default("")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  // Relations
  organization   Organization?   @relation(fields: [organizationId], references: [id])
  inventoryItems InventoryItem[]

  @@unique([organizationId, sku])
  @@unique([organizationId, barcode])
  @@index([organizationId, sku])
  @@index([organizationId, barcode])
  @@index([sku])
  @@index([barcode])
  @@map("products")
}

model InventoryItem {
  id             Int      @id @default(autoincrement())
  organizationId String?  @map("organization_id")
  productId      Int      @map("product_id")
  expiryDate     DateTime @map("expiry_date")
  locationId     Int      @map("location_id")
  status         String   @default("Normal")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  // Relations
  organization             Organization?            @relation(fields: [organizationId], references: [id])
  product                  Product                  @relation(fields: [productId], references: [id])
  storeArea                StoreArea                @relation(fields: [locationId], references: [id])
  auditLogs                AuditLog[]
  itemTransactions         ItemTransaction[]
  expiredItemTransactions  ExpiredItemTransaction[]

  @@index([organizationId])
  @@index([productId])
  @@index([locationId])
  @@index([expiryDate])
  @@index([status])
  @@map("inventory_items")
}

model StoreArea {
  id             Int       @id @default(autoincrement())
  organizationId String?   @map("organization_id")
  name           String
  subDepartment  String?   @map("sub_department")
  lastChecked    DateTime? @map("last_checked")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  // Relations
  organization   Organization?  @relation(fields: [organizationId], references: [id])
  inventoryItems InventoryItem[]

  // Unique constraint on name + sub_department combination
  @@unique([organizationId, name, subDepartment])
  @@index([organizationId])
  @@index([name])
  @@map("store_areas")
}

model User {
  id             Int      @id @default(autoincrement())
  organizationId String?  @map("organization_id")
  pin            String
  role           String
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  // Relations
  organization             Organization?            @relation(fields: [organizationId], references: [id])
  auditLogs                AuditLog[]
  itemTransactions         ItemTransaction[]
  expiredItemTransactions  ExpiredItemTransaction[]
  uploads                  Upload[]
  refreshTokens            RefreshToken[]

  @@index([organizationId])
  @@map("users")
}

model RefreshToken {
  id        Int       @id @default(autoincrement())
  userId    Int       @map("user_id")
  token     String    @unique
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  // Relations
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

model AuditLog {
  id                Int      @id @default(autoincrement())
  organizationId    String?  @map("organization_id")
  userId            Int?     @map("user_id") // Optional for system/webhook events
  inventoryItemId   Int?     @map("inventory_item_id") // Made optional for webhook audit logs
  action            String   // E.g., "webhook_processed", "subscription_updated", "item_adjusted"
  changeDescription String   @map("change_description")
  createdAt         DateTime @default(now()) @map("created_at")

  // Relations
  organization   Organization?  @relation(fields: [organizationId], references: [id])
  user           User?          @relation(fields: [userId], references: [id])
  inventoryItem  InventoryItem? @relation(fields: [inventoryItemId], references: [id])

  @@index([organizationId])
  @@index([userId])
  @@index([inventoryItemId])
  @@index([action])
  @@map("audit_log")
}

// Item Transactions (for in/out/adjustment tracking)
model ItemTransaction {
  id              Int      @id @default(autoincrement())
  organizationId  String?  @map("organization_id")
  inventoryItemId Int      @map("inventory_item_id")
  userId          Int      @map("user_id")
  type            String   // 'in', 'out', 'adjustment'
  quantityChange  Float    @map("quantity_change")
  notes           String?
  transactionDate DateTime @default(now()) @map("transaction_date")

  // Relations
  organization   Organization?  @relation(fields: [organizationId], references: [id])
  inventoryItem  InventoryItem  @relation(fields: [inventoryItemId], references: [id])
  user           User           @relation(fields: [userId], references: [id])

  @@index([organizationId])
  @@index([inventoryItemId])
  @@index([userId])
  @@index([type])
  @@index([transactionDate])
  @@map("item_transactions")
}

model ExpiredItemTransaction {
  id              Int      @id @default(autoincrement())
  organizationId  String?  @map("organization_id")
  inventoryItemId Int      @map("inventory_item_id")
  userId          Int      @map("user_id")
  action          String   // 'sold_through' or 'expired'
  unitsDiscarded  Int?     @map("units_discarded")
  financialLoss   Float?   @map("financial_loss")
  transactionDate DateTime @default(now()) @map("transaction_date")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  // Relations
  organization   Organization?  @relation(fields: [organizationId], references: [id])
  inventoryItem  InventoryItem  @relation(fields: [inventoryItemId], references: [id])
  user           User           @relation(fields: [userId], references: [id])

  @@index([organizationId])
  @@index([inventoryItemId])
  @@index([userId])
  @@index([action])
  @@index([transactionDate])
  @@map("expired_item_transactions")
}

// ============================================================================
// File Upload Tracking (for storage quota calculation)
// ============================================================================

model Upload {
  id              Int      @id @default(autoincrement())
  organizationId  String?  @map("organization_id")
  userId          Int      @map("user_id")
  fileKey         String   @unique @map("file_key")
  fileName        String   @map("file_name")
  fileSizeBytes   Int      @map("file_size_bytes")
  contentType     String?  @map("content_type")
  status          String   @default("completed")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  // Relations
  organization    Organization? @relation(fields: [organizationId], references: [id])
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt])
  @@index([userId, createdAt])
  @@index([status])
  @@index([createdAt])
  @@map("uploads")
}

// ============================================================================
// Migration Tracking (for compatibility with existing migration system)
// ============================================================================

model Migration {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  appliedAt DateTime @default(now()) @map("applied_at")

  @@map("migrations")
}
