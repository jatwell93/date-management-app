generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Organization {
  id                      String                   @id @default(uuid())
  clerkOrganizationId     String?                  @unique @map("clerk_organization_id")
  name                    String
  slug                    String                   @unique
  contactEmail            String?                  @map("contact_email")
  createdAt               DateTime                 @default(now()) @map("created_at")
  updatedAt               DateTime                 @updatedAt @map("updated_at")
  isCreationLocked        Boolean                  @default(false) @map("is_creation_locked")
  auditLogs               AuditLog[]
  expiredItemTransactions ExpiredItemTransaction[]
  inventoryItems          InventoryItem[]
  itemTransactions        ItemTransaction[]
  organizationInvites     OrganizationInvite[]
  organizationUsages      OrganizationUsage?
  products                Product[]
  storeAreas              StoreArea[]
  subscriptionTiers       SubscriptionTier[]
  trialEvents             TrialEvent[]
  uploads                 Upload[]
  users                   User[]

  @@map("organizations")
}

model SubscriptionTier {
  id                   Int          @id @default(autoincrement())
  organizationId       String       @map("organization_id")
  tierLevel            String       @map("tier_level")
  stripeSubscriptionId String?      @map("stripe_subscription_id")
  trialEndDate         DateTime?    @map("trial_end_date")
  trialStartedAt       DateTime?    @map("trial_started_at")
  trialConvertedAt     DateTime?    @map("trial_converted_at")
  pastDueSince         DateTime?    @map("past_due_since")
  status               String       @default("active")
  billingCycle         String       @default("monthly") @map("billing_cycle")
  createdAt            DateTime     @default(now()) @map("created_at")
  updatedAt            DateTime     @updatedAt @map("updated_at")
  stripeCustomerId     String?      @map("stripe_customer_id")
  organization         Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([tierLevel])
  @@index([status])
  @@index([trialEndDate])
  @@index([pastDueSince])
  @@map("subscription_tiers")
}

model TrialEvent {
  id              String       @id @default(cuid())
  organizationId  String       @map("organization_id")
  eventType       String       @map("event_type")
  occurredAt      DateTime     @default(now()) @map("occurred_at")
  metadata        String?
  sentRemindersAt String?      @map("sent_reminders_at")
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([eventType])
  @@index([occurredAt])
  @@map("trial_events")
}

model TierFeatureFlag {
  id         Int     @id @default(autoincrement())
  tierLevel  String  @map("tier_level")
  featureKey String  @map("feature_key")
  enabled    Boolean @default(true)
  limitValue Int?    @map("limit_value")

  @@unique([tierLevel, featureKey])
  @@index([tierLevel])
  @@map("tier_feature_flags")
}

model OrganizationUsage {
  id                  Int          @id @default(autoincrement())
  organizationId      String       @unique @map("organization_id")
  activeUsers         Int          @default(0) @map("active_users")
  maxUsers            Int          @map("max_users")
  totalSkus           Int          @default(0) @map("total_skus")
  maxSkus             Int          @map("max_skus")
  totalInventoryItems Int          @default(0) @map("total_inventory_items")
  maxInventoryItems   Int?         @map("max_inventory_items")
  storageUsedBytes    Int          @default(0) @map("storage_used_bytes")
  createdAt           DateTime     @default(now()) @map("created_at")
  updatedAt           DateTime     @updatedAt @map("updated_at")
  organization        Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("organization_usage")
}

model ProcessedWebhookEvent {
  id          String   @id
  eventType   String   @map("event_type")
  processedAt DateTime @default(now()) @map("processed_at")

  @@index([eventType, processedAt])
  @@map("processed_webhook_events")
}

model ClerkWebhookEvent {
  id          String   @id
  eventType   String   @map("event_type")
  processedAt DateTime @default(now()) @map("processed_at")

  @@index([eventType, processedAt])
  @@map("clerk_webhook_events")
}

model Product {
  id             Int             @id @default(autoincrement())
  organizationId String          @map("organization_id")
  barcode        String
  sku            String
  name           String
  costPrice      Float           @map("cost_price")
  notes          String          @default("")
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")
  inventoryItems InventoryItem[]
  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, sku])
  @@unique([organizationId, barcode])
  @@index([organizationId, sku])
  @@index([organizationId, barcode])
  @@index([sku])
  @@index([barcode])
  @@map("products")
}

model InventoryItem {
  id                      Int                      @id @default(autoincrement())
  organizationId          String                   @map("organization_id")
  productId               Int                      @map("product_id")
  expiryDate              DateTime                 @map("expiry_date")
  locationId              Int                      @map("location_id")
  status                  String                   @default("Normal")
  createdAt               DateTime                 @default(now()) @map("created_at")
  updatedAt               DateTime                 @updatedAt @map("updated_at")
  auditLogs               AuditLog[]
  expiredItemTransactions ExpiredItemTransaction[]
  storeArea               StoreArea                @relation(fields: [locationId], references: [id])
  product                 Product                  @relation(fields: [productId], references: [id])
  organization            Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  itemTransactions        ItemTransaction[]

  @@index([organizationId])
  @@index([productId])
  @@index([locationId])
  @@index([expiryDate])
  @@index([status])
  @@map("inventory_items")
}

model StoreArea {
  id             Int             @id @default(autoincrement())
  organizationId String          @map("organization_id")
  name           String
  subDepartment  String?         @map("sub_department")
  lastChecked    DateTime?       @map("last_checked")
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")
  inventoryItems InventoryItem[]
  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, name, subDepartment])
  @@index([organizationId])
  @@index([name])
  @@map("store_areas")
}

model User {
  id                      Int                      @id @default(autoincrement())
  organizationId          String                   @map("organization_id")
  clerkUserId             String?                  @unique @map("clerk_user_id")
  email                   String?                  @unique
  username                String?                  @unique
  role                    String
  deletedAt               DateTime?                @map("deleted_at")
  createdAt               DateTime                 @default(now()) @map("created_at")
  updatedAt               DateTime                 @updatedAt @map("updated_at")
  auditLogs               AuditLog[]
  expiredItemTransactions ExpiredItemTransaction[]
  itemTransactions        ItemTransaction[]
  sentInvites             OrganizationInvite[]     @relation("InvitedBy")
  refreshTokens           RefreshToken[]
  uploads                 Upload[]
  organization            Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([clerkUserId])
  @@index([email])
  @@index([username])
  @@map("users")
}

model OrganizationInvite {
  id              String       @id @default(uuid())
  organizationId  String       @map("organization_id")
  email           String
  role            String
  token           String       @unique
  status          String       @default("PENDING")
  expiresAt       DateTime     @map("expires_at")
  acceptedAt      DateTime?    @map("accepted_at")
  invitedByUserId Int          @map("invited_by_user_id")
  createdAt       DateTime     @default(now()) @map("created_at")
  invitedByUser   User         @relation("InvitedBy", fields: [invitedByUserId], references: [id], onDelete: Cascade)
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([email])
  @@index([status])
  @@map("organization_invites")
}

model RefreshToken {
  id        Int       @id @default(autoincrement())
  userId    Int       @map("user_id")
  token     String    @unique
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

model AuditLog {
  id                Int            @id @default(autoincrement())
  organizationId    String         @map("organization_id")
  userId            Int?           @map("user_id")
  inventoryItemId   Int?           @map("inventory_item_id")
  action            String
  changeDescription String         @map("change_description")
  createdAt         DateTime       @default(now()) @map("created_at")
  inventoryItem     InventoryItem? @relation(fields: [inventoryItemId], references: [id], onDelete: SetNull)
  user              User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  organization      Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([userId])
  @@index([inventoryItemId])
  @@index([action])
  @@map("audit_log")
}

model ItemTransaction {
  id              Int           @id @default(autoincrement())
  organizationId  String        @map("organization_id")
  inventoryItemId Int           @map("inventory_item_id")
  userId          Int?          @map("user_id")
  type            String
  quantityChange  Float         @map("quantity_change")
  notes           String?
  transactionDate DateTime      @default(now()) @map("transaction_date")
  user            User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  inventoryItem   InventoryItem @relation(fields: [inventoryItemId], references: [id])
  organization    Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([inventoryItemId])
  @@index([userId])
  @@index([type])
  @@index([transactionDate])
  @@map("item_transactions")
}

model ExpiredItemTransaction {
  id              Int           @id @default(autoincrement())
  organizationId  String        @map("organization_id")
  inventoryItemId Int           @map("inventory_item_id")
  userId          Int?          @map("user_id")
  action          String
  unitsDiscarded  Int?          @map("units_discarded")
  financialLoss   Float?        @map("financial_loss")
  transactionDate DateTime      @default(now()) @map("transaction_date")
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")
  user            User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  inventoryItem   InventoryItem @relation(fields: [inventoryItemId], references: [id])
  organization    Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([inventoryItemId])
  @@index([userId])
  @@index([action])
  @@index([transactionDate])
  @@map("expired_item_transactions")
}

model Upload {
  id                Int          @id @default(autoincrement())
  organizationId    String       @map("organization_id")
  userId            Int          @map("user_id")
  fileKey           String       @unique @map("file_key")
  fileName          String       @map("file_name")
  fileSizeBytes     Int          @map("file_size_bytes")
  contentType       String?      @map("content_type")
  status            String       @default("pending") // pending, uploading, processing, completed, failed
  uploadProgress    Int          @default(0) @map("upload_progress") // 0-100
  processingMessage String?      @map("processing_message") // Current processing step
  errorMessage      String?      @map("error_message") // Error details if failed
  rowsProcessed     Int          @default(0) @map("rows_processed") // CSV rows processed
  rowsTotal         Int?         @map("rows_total") // Total rows in CSV
  rowsImported      Int          @default(0) @map("rows_imported") // Rows inserted as new products
  rowsUpdated       Int          @default(0) @map("rows_updated") // Rows applied as updates
  rowsSkipped       Int          @default(0) @map("rows_skipped") // Rows skipped due to validation/business errors
  rowErrorCount     Int          @default(0) @map("row_error_count") // Total row-level errors
  columnsUsed       String?     @map("columns_used") // JSON array of column names that were used
  columnsIgnored    Int          @default(0) @map("columns_ignored") // Number of columns ignored
  createdAt         DateTime     @default(now()) @map("created_at")
  updatedAt         DateTime     @updatedAt @map("updated_at")
  user              User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization      Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt])
  @@index([userId, createdAt])
  @@index([status])
  @@index([createdAt])
  @@map("uploads")
}

model Migration {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  appliedAt DateTime @default(now()) @map("applied_at")

  @@map("migrations")
}

model MetricsSnapshot {
  id                  Int      @id @default(autoincrement())
  date                DateTime @unique
  trialConversionRate Float?   @map("trial_conversion_rate")
  avgRevenuePerUser   Float?   @map("avg_revenue_per_user")
  churnRate           Float?   @map("churn_rate")
  totalTrials         Int      @default(0) @map("total_trials")
  totalConversions    Int      @default(0) @map("total_conversions")
  totalChurn          Int      @default(0) @map("total_churn")
  totalRevenueCents   Int      @default(0) @map("total_revenue_cents")
  tierDistribution    String?  @map("tier_distribution") // JSON string
  createdAt           DateTime @default(now()) @map("created_at")

  @@index([date])
  @@map("metrics_snapshots")
}

model WebhookMetrics {
  id           Int      @id @default(autoincrement())
  eventType    String   @map("event_type")
  totalCount   Int      @default(0) @map("total_count")
  failureCount Int      @default(0) @map("failure_count")
  date         DateTime
  createdAt    DateTime @default(now()) @map("created_at")

  @@unique([eventType, date])
  @@index([eventType])
  @@index([date])
  @@map("webhook_metrics")
}
