# Environment variables for the frontend
# Copy this file to .env and update the values accordingly

# API URL - defaults to localhost:3001 for development
REACT_APP_API_URL=http://localhost:3001

# Sentry DSN for frontend error tracking
REACT_APP_SENTRY_FRONTEND_DSN=https://your-frontend-sentry-dsn@sentry.io/project-id

# Workers URL for testing Workers Sentry integration
REACT_APP_WORKERS_URL=https://your-workers-subdomain.workers.dev

# Clerk Authentication (from https://dashboard.clerk.com/last-active?path=api-keys)
# Get your Publishable Key from Clerk Dashboard → API Keys → Choose React
REACT_APP_CLERK_PUBLISHABLE_KEY=pk_test_your_publishable_key_here