{
  "name": "date-management-app",
  "version": "0.0.0",
  "description": "Monorepo for date management application with backend, frontend, and workers",
  "main": "build/src/index.js",
  "types": "build/src/index.d.ts",
  "files": [
    "build/src"
  ],
  "license": "Apache-2.0",
  "keywords": [],
  "scripts": {
    "test": "echo \"Error: no root test suite. Run test:db, test:frontend:diff, test:migrations or test:operations\" && exit 1",
    "build:frontend": "npm run build --prefix frontend",
    "build:workers": "npm run build --prefix workers",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:db": "npm run test:db --prefix workers",
    "test:migrations": "npm run compile && node --test --test-concurrency=1 build/src/database/migrations/runner.test.js build/src/database/migrations/adopt.test.js build/src/database/migrations/baseline.fingerprint.test.js build/src/database/migrations/commands.test.js build/src/database/migrations/log.test.js build/src/database/migrations/pglite-client.test.js",
    "test:migrations:e2e": "npm run compile && node --test --test-concurrency=1 \"build/src/database/migrations/e2e.test.js\"",
    "test:operations": "npm run compile && node --test --test-concurrency=1 build/src/operations/master-catalogue-seed.test.js build/src/operations/seed-master-catalogue-cli.test.js build/src/operations/webhook-diagnostics.test.js build/src/operations/with-connection.test.js",
    "test:frontend:coverage": "npm run test:coverage --prefix frontend",
    "test:frontend:diff": "npm run test:diff --prefix frontend",
    "test:load": "npx --yes artillery@2.0.34 run artillery.yml",
    "test:load:quick": "npx --yes artillery@2.0.34 quick --count 20 --num 100 https://date-management-api-dev.date-management-app.workers.dev/health",
    "test:load:report": "npx --yes artillery@2.0.34 run artillery.yml --output artillery-report.json && npx --yes artillery@2.0.34 report artillery-report.json",
    "security:npm-supply-chain": "node scripts/check-npm-supply-chain.js",
    "validate:stripe-config": "node scripts/validate-stripe-deployment-config.js",
    "test:stripe-config": "node --test scripts/validate-stripe-deployment-config.test.js",
    "test:neon-scripts": "node --test scripts/check-neon-pitr.test.js scripts/create-neon-snapshot.test.js scripts/neon-poll-operations.test.js",
    "test:tooling": "node --test scripts/lint-diff.test.js scripts/memvid-exec.test.js scripts/mem-memory-scripts.test.js scripts/root-package-scripts.test.js scripts/workers-dev-local.test.js scripts/verify-scheduled-triggers.test.js scripts/backup-retention.test.js scripts/artillery-processor.test.js",
    "mem:log": "node scripts/mem-log.js",
    "mem:recall": "node scripts/mem-recall.js",
    "mem:rebuild": "node scripts/mem-rebuild.js",
    "migrate:apply": "npm run compile && node build/src/database/migrations/cli.js",
    "migrate:adopt": "npm run compile && node build/src/database/migrations/adopt-cli.js",
    "migrate:status": "npm run compile && node build/src/database/migrations/status-cli.js",
    "migrate:preflight": "npm run compile && node build/src/database/migrations/preflight-cli.js",
    "migrate:seed": "npm run compile && node build/src/database/migrations/seed-cli.js",
    "migrate:verify": "npm run compile && node build/src/database/migrations/verify-cli.js",
    "seed:master-catalogue": "npm run compile && node build/src/operations/seed-master-catalogue-cli.js",
    "diagnose:webhook": "npm run compile && node build/src/operations/diagnose-webhook-cli.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint:check": "eslint . --max-warnings=0",
    "lint:diff": "node scripts/lint-diff.js",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "compile": "tsc",
    "prepare": "npm run compile",
    "pretest": "npm run compile",
    "posttest": "npm run lint"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.4",
    "@eslint/js": "^9.39.0",
    "@playwright/test": "1.62.1",
    "@types/node": "26.2.0",
    "@types/pg": "8.21.0",
    "@typescript-eslint/eslint-plugin": "8.66.0",
    "@typescript-eslint/parser": "8.66.0",
    "browserstack-local": "1.5.13",
    "dotenv": "^17.2.3",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.29.1",
    "eslint-plugin-jsx-a11y": "^6.9.0",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-react": "^7.37.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "exceljs": "4.4.0",
    "globals": "^17.9.0",
    "prettier": "3.9.6",
    "typescript": "^6.0.3",
    "wrangler": "4.144.0"
  },
  "dependencies": {
    "pg": "8.22.0"
  }
}
