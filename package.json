{
  "name": "date-management-app",
  "version": "0.0.0",
  "description": "Monorepo for date management application with backend, frontend, and workers",
  "main": "build/src/index.js",
  "types": "build/src/index.d.ts",
  "files": [
    "build/src"
  ],
  "license": "Apache-2.0",
  "keywords": [],
  "scripts": {
    "test": "echo \"Error: specify frontend or backend (npm run test:backend or npm run test:frontend)\" && exit 1",
    "build:frontend": "npm run build --prefix frontend",
    "build:workers": "npm run build --prefix workers",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:backend": "npm run test --prefix backend",
    "test:backend:coverage": "npm run test:coverage --prefix backend",
    "test:backend:diff": "npm run test:diff --prefix backend",
    "test:frontend:coverage": "npm run test:coverage --prefix frontend",
    "test:frontend:diff": "npm run test:diff --prefix frontend",
    "test:load": "TEST_PASSWORD=LoadTest123! artillery run artillery.yml",
    "test:load:quick": "TEST_PASSWORD=LoadTest123! artillery quick --count 20 --num 100 https://date-management-api-dev.date-management-app.workers.dev/health",
    "test:load:report": "TEST_PASSWORD=LoadTest123! artillery run artillery.yml --output artillery-report.json && artillery report artillery-report.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint:check": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "compile": "tsc",
    "prepare": "npm.cmd run compile",
    "pretest": "npm.cmd run compile",
    "posttest": "npm.cmd run lint"
  },
  "devDependencies": {
    "@eslint/js": "^8.57.1",
    "@playwright/test": "^1.58.2",
    "@types/node": "^22.7.5",
    "@typescript-eslint/eslint-plugin": "^8.44.1",
    "@typescript-eslint/parser": "^8.44.1",
    "browserstack-local": "^1.5.8",
    "dotenv": "^17.2.3",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.29.1",
    "eslint-plugin-jsx-a11y": "^6.9.0",
    "eslint-plugin-prettier": "^5.5.4",
    "eslint-plugin-react": "^7.37.1",
    "eslint-plugin-react-hooks": "^4.6.2",
    "globals": "^15.14.0",
    "prettier": "^3.6.2",
    "typescript": "^5.6.3",
    "wrangler": "^4.61.1"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "prisma": "^5.22.0"
  }
}
