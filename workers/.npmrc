# The Worker deliberately pins `@cloudflare/workers-types@^4` because
# `@sentry/cloudflare` has a `peerOptional` on `^4.x`. `wrangler@4.112.0`
# raised its own `peerOptional` to `@cloudflare/workers-types@^5`, so the two
# optional peers are now mutually unsatisfiable. Neither optional peer is
# actually consumed at runtime, so we tolerate the conflict here. This scopes
# `legacy-peer-deps` to the workers install only (the repo-root `.npmrc` keeps
# `legacy-peer-deps=false`), letting CI's `npm ci` replay the locked v4 tree
# instead of rejecting it with ERESOLVE. Revisit when Sentry supports
# workers-types v5, then drop this file.
legacy-peer-deps=true
