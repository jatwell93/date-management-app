{
  "name": "date-management-workers",
  "version": "1.0.0",
  "description": "Cloudflare Workers production deployment for Date Management API",
  "main": "dist/index.js",
  "scripts": {
    "dev": "wrangler dev",
    "build": "node build.js",
    "build:types": "tsc --noEmit -p tsconfig.deploy.json",
    "lint": "tsc --noEmit -p tsconfig.deploy.json",
    "deploy": "npm run build && wrangler deploy",
    "deploy:prod": "npm run build && wrangler deploy --env production",
    "deploy:dev": "npm run build && wrangler deploy --env development",
    "tail": "wrangler tail",
    "tail:prod": "wrangler tail --env production",
    "test": "vitest",
    "test:preview": "cross-env RUN_WORKERS_PREVIEW_TESTS=true vitest run src/workers-deployment.test.ts",
    "test:db": "vitest run --config vitest.node.config.mts",
    "test:workers:integration": "vitest run src/__tests__",
    "test:workers:integration:coverage": "vitest run src/__tests__ --coverage --coverage.provider=istanbul",
    "test:coverage": "vitest --coverage --coverage.provider=istanbul"
  },
  "keywords": [
    "cloudflare",
    "workers",
    "serverless",
    "api"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@clerk/backend": "^3.5.0",
    "@cloudflare/workers-types": "^4.20260524.1",
    "@neondatabase/serverless": "^1.1.0",
    "@sentry/cloudflare": "^10.53.1",
    "jose": "^6.2.3"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.16.9",
    "@electric-sql/pglite": "^0.5.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20.19.41",
    "@vitest/coverage-istanbul": "^4.1.7",
    "@vitest/coverage-v8": "^4.1.7",
    "cross-env": "^7.0.3",
    "esbuild": "^0.27.7",
    "typescript": "^5.3.3",
    "vitest": "^4.1.7",
    "wrangler": "^4.94.0"
  }
}
