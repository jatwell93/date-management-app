{
  "name": "date-management-workers",
  "version": "1.0.0",
  "description": "Cloudflare Workers production deployment for Date Management API",
  "main": "src/index.ts",
  "scripts": {
    "dev": "wrangler dev",
    "build": "tsc",
    "deploy": "wrangler deploy",
    "deploy:prod": "wrangler deploy --env production",
    "deploy:dev": "wrangler deploy --env development",
    "tail": "wrangler tail",
    "tail:prod": "wrangler tail --env production",
    "test": "vitest",
    "test:coverage": "vitest --coverage"
  },
  "keywords": [
    "cloudflare",
    "workers",
    "serverless",
    "api"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@cloudflare/workers-types": "^4.20241127.0"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "typescript": "^5.3.3",
    "vitest": "^1.2.0",
    "wrangler": "^4.61.1"
  }
}
