{
  "name": "date-management-workers",
  "version": "1.0.0",
  "description": "Cloudflare Workers production deployment for Date Management API",
  "main": "dist/index.js",
  "scripts": {
    "dev": "wrangler dev",
    "build": "node build.js",
    "build:types": "tsc --noEmit",
    "deploy": "npm run build && wrangler deploy",
    "deploy:prod": "npm run build && wrangler deploy --env production",
    "deploy:dev": "npm run build && wrangler deploy --env development",
    "tail": "wrangler tail",
    "tail:prod": "wrangler tail --env production",
    "test": "vitest",
    "test:coverage": "vitest --coverage"
  },
  "keywords": [
    "cloudflare",
    "workers",
    "serverless",
    "api"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@cloudflare/workers-types": "^4.20241127.0",
    "@neondatabase/serverless": "^1.0.2",
    "jose": "^6.1.3"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20.11.0",
    "esbuild": "^0.27.2",
    "typescript": "^5.3.3",
    "vitest": "^1.2.0",
    "wrangler": "^4.61.1"
  }
}
